{
  "name": "cobalt-skymap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:about-deps": "node scripts/generate-about-dependencies.cjs",
    "fetch:astap": "node scripts/fetch-astap.mjs",
    "dev": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next dev -p 1420",
    "dev:tauri": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true node scripts/dev-server.cjs",
    "build": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next build",
    "build:desktop": "pnpm fetch:astap && pnpm build && pnpm exec tauri build --config src-tauri/tauri.prebuilt.conf.json",
    "build:desktop:windows": "node scripts/fetch-astap.mjs --target x86_64-pc-windows-msvc && pnpm build && pnpm exec tauri build --config src-tauri/tauri.prebuilt.conf.json --target x86_64-pc-windows-msvc",
    "start": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true next start",
    "lint": "node scripts/generate-about-dependencies.cjs && eslint",
    "test": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true jest",
    "test:watch": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true jest --watch",
    "test:coverage": "node scripts/generate-about-dependencies.cjs && cross-env BROWSERSLIST_IGNORE_OLD_DATA=true BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=true jest --coverage",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:smoke": "pnpm exec playwright test --project=chromium --grep @smoke",
    "test:e2e:regression": "pnpm exec playwright test --project=chromium --grep @regression --grep-invert @mobile",
    "build:updater-manifest": "node scripts/updater/build-latest-json.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
